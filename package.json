    "check": "npm test && npm run build && npm run qa"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/caveat-brush": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
